# Choose "ollama" for free local analysis, or "anthropic" for Claude (paid, needs a key below).
AI_PROVIDER=ollama

# Ollama runs beside the backend by default (on whatever computer hosts it).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_TEXT_CHARS=20000
OLLAMA_TIMEOUT_SECONDS=240

# Long documents: maximum number of parts per PDF, and parts analyzed at once
# (defaults: 1 for Ollama, 4 for Anthropic).
ANALYSIS_MAX_PARTS=12
# ANALYSIS_CONCURRENCY=1

# Optional paid provider; not needed for local Ollama.
# Create a key at https://console.anthropic.com/ and paste it here yourself; never commit backend/.env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: how much reasoning the model spends per request.
ANTHROPIC_EFFORT=medium
# Characters per request before a document is split into parts.
# ANTHROPIC_MAX_TEXT_CHARS=200000
# ANTHROPIC_TIMEOUT_SECONDS=240
